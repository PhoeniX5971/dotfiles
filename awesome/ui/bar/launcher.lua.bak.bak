local wibox = require("wibox")
local awful = require("awful")
local gears = require("gears")
local beautiful = require("beautiful")
local helpers = require("helpers")
local dpi = beautiful.xresources.apply_dpi

local Launcher = wibox({
	y = dpi(45),
	type = "dock",
	ontop = true,
	visible = false,
	width = dpi(600),
	height = dpi(1400),
	bg = beautiful.bg_normal,
	-- shape = helpers.rrect(dpi(25)),
})

Launcher:connect_signal("button::press", function(_, _, _, button)
	if button == 3 then
		Launcher.visible = false
	end
end)

local app_list_widget = wibox.widget({
	spacing = dpi(8),
	layout = wibox.layout.fixed.vertical,
})

local entries_per_page = 24 -- Number of visible entries at a time
local index_start = 1 -- Starting index for the current page
local selected_item = 1 -- Index of the currently selected item
local filtered_apps = {} -- List of filtered applications
local visible_widgets = {} -- Pool of visible widgets

-- Function to read the app list from apps.txt
local function read_app_list(file_path)
	local apps = {}
	for line in io.lines(file_path) do
		local icon_path, launch_path, app_name = line:match("([^,]+),%s*([^,]+),%s*(.+)")
		if icon_path and launch_path and app_name then
			table.insert(apps, { icon = icon_path, exec = launch_path, name = app_name })
		end
	end
	return apps
end

-- Load apps from file
local apps = read_app_list(os.getenv("HOME") .. "/.config/awesome/launcher/apps.txt")
filtered_apps = apps -- Initially, all apps are visible

-- Initialize visible widgets (pool)
local function init_visible_widgets()
	for i = 1, entries_per_page do
		local app_item = wibox.widget({
			{
				{
					{
						id = "icon",
						widget = wibox.widget.imagebox,
						resize = true,
						forced_width = dpi(32),
						forced_height = dpi(32),
					},
					{
						id = "name",
						widget = wibox.widget.textbox,
						font = "DM Mono 14",
					},
					spacing = dpi(25),
					layout = wibox.layout.fixed.horizontal,
				},
				widget = wibox.container.margin,
				margins = dpi(10),
			},
			bg = beautiful.bg_normal,
			shape = helpers.rrect(dpi(50)),
			widget = wibox.container.background,
		})

		-- Add click functionality
		app_item:buttons(gears.table.join(awful.button({}, 1, function()
			local app = filtered_apps[index_start + i - 1]
			if app then
				awful.spawn(app.exec)
				Launcher.visible = false
			end
		end)))

		-- Add hover effect
		helpers.add_hover_cursor(app_item, "hand2")

		-- Add widget to the pool and list widget
		visible_widgets[i] = app_item
		app_list_widget:add(app_item)
	end
end

-- Update visible widgets based on the current index
local function Update_app_list()
	for i, widget in ipairs(visible_widgets) do
		local app_index = index_start + i - 1
		local app = filtered_apps[app_index]

		if app then
			widget.visible = true
			widget:get_children_by_id("icon")[1].image = app.icon
			widget:get_children_by_id("name")[1].text = app.name:len() > 30 and app.name:sub(1, 27) .. "..." or app.name
			widget.bg = app_index == selected_item and beautiful.bg_focus or beautiful.bg_normal
		else
			widget.visible = false
		end
	end
end

-- Ensure the selected item is visible
local function ensure_visible()
	if selected_item < index_start then
		index_start = selected_item
	elseif selected_item >= index_start + entries_per_page then
		index_start = selected_item - entries_per_page + 1
	end
	Update_app_list()
end

-- Move to the next item
local function select_next_item()
	if selected_item < #filtered_apps then
		selected_item = selected_item + 1
		ensure_visible()
	end
end

-- Move to the previous item
local function select_prev_item()
	if selected_item > 1 then
		selected_item = selected_item - 1
		ensure_visible()
	end
end

-- Search filter function
local function filter(query)
	filtered_apps = {}
	for _, app in ipairs(apps) do
		if app.name:lower():match(query:lower()) then
			table.insert(filtered_apps, app)
		end
	end
	index_start = 1
	selected_item = 1
	Update_app_list()
end

-- Search box widget
local search_box = wibox.widget.textbox()
search_box:set_text(" Search")
search_box:set_align("center")
search_box.font = "DM Mono Bold 14"

search_box:connect_signal("key::release", function(_, _, _, key)
	if key == "Return" then
		filter(search_box.text)
	elseif key == "Down" then
		select_next_item()
	elseif key == "Up" then
		select_prev_item()
	end
end)

Launcher:buttons(gears.table.join(
	awful.button({}, 4, function()
		-- Scroll up, move the view window up without changing the selected item
		if index_start > 1 then
			index_start = index_start - 1
			Update_app_list()
		end
	end),
	awful.button({}, 5, function()
		-- Scroll down, move the view window down without changing the selected item
		if index_start + entries_per_page - 1 < #filtered_apps then
			index_start = index_start + 1
			Update_app_list()
		end
	end)
))

local search_box_widget = wibox.widget({
	{
		search_box,
		margins = dpi(10),
		widget = wibox.container.margin,
	},
	bg = "#5f5f5f",
	shape = helpers.rrect(dpi(50)),
	widget = wibox.container.background,
})

Launcher.widget = {
	{
		search_box_widget,
		{
			app_list_widget,
			margins = dpi(15),
			widget = wibox.container.margin,
		},
		align = "center",
		layout = wibox.layout.align.vertical,
	},
	margins = dpi(10),
	widget = wibox.container.margin,
}

local keygrabber_instance = nil

local function start_keygrabber()
	if keygrabber_instance then
		return
	end
	keygrabber_instance = awful.keygrabber({
		start_callback = function() end,
		stop_callback = function()
			keygrabber_instance = nil
		end,
		keybindings = {
			{
				{},
				"Escape",
				function()
					Launcher.visible = false
					index_start = 1
					selected_item = 1
					Update_app_list()
				end,
			},
			{ {}, "Down", select_next_item },
			{ {}, "Up", select_prev_item },
			{
				{},
				"Return",
				function()
					if filtered_apps[selected_item] then
						awful.spawn(filtered_apps[selected_item].exec)
						Launcher.visible = false
					end
				end,
			},
		},
		stop_event = "release",
	})
	keygrabber_instance:start()
end

Launcher:connect_signal("property::visible", function()
	if Launcher.visible then
		start_keygrabber()
	elseif keygrabber_instance then
		keygrabber_instance:stop()
		index_start = 1
		selected_item = 1
		Update_app_list()
	end
end)

-- Initialize the visible widgets and update the app list
init_visible_widgets()
Update_app_list()

return Launcher
